DEFINE INSTRUMENT odin_sample (
double l_min = 1, 
double l_max = 11, 
int n_pulses = 1, 
double wfm_delta = 0.3, 
double bp_frequency = 7, 
double bp1_phase_offset = 0, 
double jitter_bp1 = 0, 
double bp2_phase_offset = 0, 
double jitter_bp2 = 0, 
double t0_phase_offset = 0, 
double jit_t0_sec = 0, 
int n_repeats = 1, 
string run_from_mcpl = "mcpl_files/big_1496.mcpl.gz",
string run_ml = ""
)

DECLARE 
%{
double bp1_phase = 0;
double bp2_phase = 0;
double t0_phase = 0;
%}

INITIALIZE 
%{
// Start of initialize for generated odin_sample
bp1_phase = bp1_phase_offset;
bp1_phase += -11.475;
bp2_phase = bp2_phase_offset;
bp2_phase += 185.195;
t0_phase = t0_phase_offset;
%}

TRACE 

COMPONENT MCPL_optical_axis_backend = MCPL_input(
 filename = run_from_mcpl, repeat_count = n_repeats) WHEN (strcmp(run_ml, "") == 0)
AT (0,      0,      0) ABSOLUTE

COMPONENT ml_src = Source_ML(
    ML_filename = run_ml,
    verbose=0
) WHEN (strcmp(run_ml, "") != 0)
AT (0,0,0) ABSOLUTE


COMPONENT optical_axis_backend = Arm()
AT (0,      0,      0) ABSOLUTE

COMPONENT sample_monitor_arm = Arm()
AT (0,      0,      60.5) RELATIVE optical_axis_backend

COMPONENT sample_PSD = PSD_monitor(
 nx = 300, ny = 300,
 filename = "image.dat", xwidth = 0.3,
 yheight = 0.3, restore_neutron = 1)
AT (0,      0,      0) RELATIVE sample_monitor_arm

COMPONENT profile_x = PSDlin_monitor(
 nbins = 300, filename = "profile_x.dat",
 xwidth = 0.3, yheight = 0.3,
 restore_neutron = 1)
AT (0,      0,      0) RELATIVE sample_monitor_arm

COMPONENT profile_y = PSDlin_monitor(
 nbins = 300, filename = "profile_y.dat",
 xwidth = 0.3, yheight = 0.3,
 restore_neutron = 1, vertical = 1)
AT (0,      0,      0) RELATIVE sample_monitor_arm

COMPONENT wavelength = L_monitor(
 nL = 1200, filename = "wavelength.dat",
 xwidth = 0.3, yheight = 0.3,
 Lmin = l_min, Lmax = l_max,
 restore_neutron = 1)
AT (0,      0,      0) RELATIVE sample_monitor_arm

COMPONENT sample_position = Arm()
AT (0,      0,      60.5) RELATIVE optical_axis_backend

COMPONENT init = Union_init()
AT (0,      0,      0) ABSOLUTE

COMPONENT al_pow = Powder_process(
 reflections = "Al.laz", interact_fraction = 0.2)
AT (0,      0,      0) ABSOLUTE

COMPONENT al_inc = Incoherent_process(
 sigma = 0.0328, unit_cell_volume = 66.4,
 interact_fraction = 0.2)
AT (0,      0,      0) ABSOLUTE

COMPONENT al = Union_make_material(
 process_string = "al_inc,al_pow", my_absorption = 1.391566265060241)
AT (0,      0,      0) ABSOLUTE

COMPONENT sample_nc = NCrystal_process(
 cfg = "Fe_sg225_Iron-gamma.ncmat;temp=25C")
AT (0,      0,      0) ABSOLUTE

COMPONENT sample = Union_make_material(
 process_string = "sample_nc", my_absorption = 2.56)
AT (0,      0,      0) ABSOLUTE

COMPONENT gas_nc = NCrystal_process(
 cfg = "gasmix::H2/10bar")
AT (0,      0,      0) ABSOLUTE

COMPONENT gas = Union_make_material(
 process_string = "gas_nc", my_absorption = 21.29)
AT (0,      0,      0) ABSOLUTE

COMPONENT metal_cyl_env = Union_cylinder(
 material_string = "al", priority = 40,
 radius = 0.017, yheight = 0.075)
AT (0,      0,      0) RELATIVE sample_position

COMPONENT vacuum_cyl_env = Union_cylinder(
 material_string = "Vacuum", priority = 41,
 radius = 0.024 / 2, yheight = 0.055)
AT (0,      0,      0) RELATIVE sample_position

COMPONENT vacuum_cyl_narrow = Union_cylinder(
 material_string = "Vacuum", priority = 42,
 radius = 0.014 / 2, yheight = 0.080)
AT (0,      0,      0) RELATIVE sample_position

COMPONENT sample_cyl_metal = Union_cylinder(
 material_string = "sample", priority = 50,
 radius = 0.005 / 2, yheight = 0.034)
AT (0,      0,      0) RELATIVE sample_position

COMPONENT sample_cyl_gas = Union_cylinder(
 material_string = "gas", priority = 51,
 radius = 0.004 / 2, yheight = 0.033)
AT (0,      0,      0) RELATIVE sample_position

COMPONENT logger_space_zx = Union_logger_2D_space(
 D_direction_1 = "z", D1_min = -0.05,
 D1_max = 0.05, n1 = 300,
 D_direction_2 = "x", D2_min = -0.05,
 D2_max = 0.05, n2 = 300,
 filename = "logger_zx.dat")
AT (0,      0,      0) RELATIVE sample_position
ROTATED (0.0,      0.0,      0.0) RELATIVE sample_position

COMPONENT logger_space_zy = Union_logger_2D_space(
 D_direction_1 = "z", D1_min = -0.05,
 D1_max = 0.05, n1 = 300,
 D_direction_2 = "y", D2_min = -0.05,
 D2_max = 0.05, n2 = 300,
 filename = "logger_zy.dat")
AT (0,      0,      0) RELATIVE sample_position
ROTATED (0.0,      0.0,      0.0) RELATIVE sample_position

COMPONENT Sample_environment = Union_master(
 verbal = 0)
AT (0,      0,      0) RELATIVE sample_position
ROTATED (0.0,      0.0,      0.0) RELATIVE sample_position

COMPONENT stop = Union_stop()
AT (0,      0,      0) RELATIVE sample_position
ROTATED (0.0,      0.0,      0.0) RELATIVE sample_position

COMPONENT detector = Monitor_nD(
 xwidth = 0.0055, yheight = 0.045,
 restore_neutron = 1, options = "square x bins=150 y bins=150",
 filename = "detector.dat")
AT (0,      0,      0.0175) RELATIVE sample_position

FINALLY 
%{
// Start of finally for generated odin_sample
%}

END
