/*******************************************************************************
*         McStas instrument definition URL=http://www.mcstas.org
*
* Instrument: Test_Source_ML
*
* %Identification
* Written by: Daniel Lomholt Christensen
* Date: September 2026
* Origin: NBI@UCPH funded by ACTNXT
* %INSTRUMENT_SITE: Templates
*
* Smoke test for the fused Source_ML component (mcstas_comps/Source_ML.comp),
* which replaces the former separate onnx_implementation/test.instr and
* torchscript/Test_Source_ML_torch.instr.
*
* %D
* Defaults point at the untrained ONNX smoke-test artifact produced by
* export_onnx_smoke.py (CFM_sampler.onnx) in this directory, not a trained
* model -- this only exercises the load/generate/emit pipeline. The inverse
* Gaussian-rank transform is embedded in the exported model itself (see
* ../utils/data_load.py), so no separate transform file is needed.
*
* Example: mcrun Test_Source_ML.instr model_filename=CFM_sampler.onnx backend=auto
* Example: mcrun Test_Source_ML.instr model_filename=CFM_sampler.pt backend=auto
*
* %P
* model_filename: [str]  Path to the .onnx or .pt/.pth model to sample from.
* backend: [str]         "auto" (default), "onnx", or "torch" -- see
*                         Source_ML.comp's own %P documentation.
* device: [str]          ONNX Runtime execution provider (backend="onnx" only).
*
* %Link
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT Test_Source_ML(string model_filename = "../data_files/models/CFM_sampler.onnx",
                                  string backend = "auto",
                                  string device = "auto")

DECLARE
%{
%}

INITIALIZE
%{
%}

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE

COMPONENT src = Source_ML(
    ML_filename = model_filename,
    backend = backend,
    device = device,
    verbose = 0, GPU_verbose = 0
    )
AT(0,0,0) ABSOLUTE



COMPONENT sample_position = Arm()
AT (0,      0,      60.5) ABSOLUTE

COMPONENT init = Union_init()
AT (0,      0,      0) ABSOLUTE

COMPONENT al_pow = Powder_process(
 reflections = "Al.laz", interact_fraction = 0.2)
AT (0,      0,      0) ABSOLUTE

COMPONENT al_inc = Incoherent_process(
 sigma = 0.0328, unit_cell_volume = 66.4,
 interact_fraction = 0.2)
AT (0,      0,      0) ABSOLUTE

COMPONENT al = Union_make_material(
 process_string = "al_inc,al_pow", my_absorption = 1.391566265060241)
AT (0,      0,      0) ABSOLUTE

COMPONENT sample_nc = NCrystal_process(
 cfg = "Fe_sg225_Iron-gamma.ncmat;temp=25C")
AT (0,      0,      0) ABSOLUTE

COMPONENT sample = Union_make_material(
 process_string = "sample_nc", my_absorption = 2.56)
AT (0,      0,      0) ABSOLUTE

COMPONENT gas_nc = NCrystal_process(
 cfg = "gasmix::H2/10bar")
AT (0,      0,      0) ABSOLUTE

COMPONENT gas = Union_make_material(
 process_string = "gas_nc", my_absorption = 21.29)
AT (0,      0,      0) ABSOLUTE

COMPONENT metal_cyl_env = Union_cylinder(
 material_string = "al", priority = 40,
 radius = 0.017, yheight = 0.075)
AT (0,      0,      0) RELATIVE sample_position

COMPONENT vacuum_cyl_env = Union_cylinder(
 material_string = "Vacuum", priority = 41,
 radius = 0.024 / 2, yheight = 0.055)
AT (0,      0,      0) RELATIVE sample_position

COMPONENT vacuum_cyl_narrow = Union_cylinder(
 material_string = "Vacuum", priority = 42,
 radius = 0.014 / 2, yheight = 0.080)
AT (0,      0,      0) RELATIVE sample_position

COMPONENT sample_cyl_metal = Union_cylinder(
 material_string = "sample", priority = 50,
 radius = 0.005 / 2, yheight = 0.034)
AT (0,      0,      0) RELATIVE sample_position

COMPONENT sample_cyl_gas = Union_cylinder(
 material_string = "gas", priority = 51,
 radius = 0.004 / 2, yheight = 0.033)
AT (0,      0,      0) RELATIVE sample_position

COMPONENT logger_space_zx = Union_logger_2D_space(
 D_direction_1 = "z", D1_min = -0.05,
 D1_max = 0.05, n1 = 300,
 D_direction_2 = "x", D2_min = -0.05,
 D2_max = 0.05, n2 = 300,
 filename = "logger_zx.dat")
AT (0,      0,      0) RELATIVE sample_position
ROTATED (0.0,      0.0,      0.0) RELATIVE sample_position

COMPONENT logger_space_zy = Union_logger_2D_space(
 D_direction_1 = "z", D1_min = -0.05,
 D1_max = 0.05, n1 = 300,
 D_direction_2 = "y", D2_min = -0.05,
 D2_max = 0.05, n2 = 300,
 filename = "logger_zy.dat")
AT (0,      0,      0) RELATIVE sample_position
ROTATED (0.0,      0.0,      0.0) RELATIVE sample_position

COMPONENT Sample_environment = Union_master(
 verbal = 0)
AT (0,      0,      0) RELATIVE sample_position
ROTATED (0.0,      0.0,      0.0) RELATIVE sample_position

COMPONENT stop = Union_stop()
AT (0,      0,      0) RELATIVE sample_position
ROTATED (0.0,      0.0,      0.0) RELATIVE sample_position

COMPONENT detector = Monitor_nD(
 xwidth = 0.0055, yheight = 0.045,
 restore_neutron = 1, options = "square x bins=150 y bins=150",
 filename = "detector.dat")
AT (0,      0,      0.0175) RELATIVE sample_position

FINALLY
%{
%}
END
