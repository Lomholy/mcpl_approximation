DEFINE COMPONENT Source_ML

SETTING PARAMETERS (string ML_filename="",
                    string transformer_filename = "",
                    int batch_size = 10000,
                    verbose=1
                   )


DEPENDENCY "@MCPLFLAGS@ -I$CONDA_PREFIX/include -L$CONDA_PREFIX/lib -lonnxruntime -Wl,-rpath,$CONDA_PREFIX/lib"


SHARE
%{
  

  #include <stdio.h>
  #include "onnxruntime/core/session/onnxruntime_c_api.h"

  #include <stdlib.h>
  #include <math.h>
  #include <sys/stat.h>
  #include <stdio.h>
  


  #define CHECK(status)                                  \
    if (status != NULL) {                              \
        fprintf(stderr, "Error: %s\n",                 \
                api->GetErrorMessage(status));         \
        api->ReleaseStatus(status);                   \
        exit(1);                                      \
    }

  // Functions for Gauss rank scaling
  #define SQRT2 1.4142135623730951

  #include <time.h>

double walltime()
{
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec + 1e-9 * ts.tv_nsec;
}

// --------------------------------------------------
// Load binary transform
// --------------------------------------------------
void load_transform_binary(char* path,
                           int* n, int* d,
                           double** grid,
                           double** sorted_cols)
{
    FILE* f = fopen(path, "rb");
    if (!f) {
        perror("fopen");
        exit(1);
    }

    fread(n, sizeof(int), 1, f);
    fread(d, sizeof(int), 1, f);

    *grid = malloc((*n) * sizeof(double));
    *sorted_cols = malloc((*n) * (*d) * sizeof(double));

    fread(*grid, sizeof(double), *n, f);
    fread(*sorted_cols, sizeof(double), (*n) * (*d), f);

    fclose(f);
}

// --------------------------------------------------
// Normal CDF (matches your Python version)
// --------------------------------------------------
double normal_cdf(double z)
{
    return 0.5 * (1.0 + erf(z / SQRT2));
}

// --------------------------------------------------
// Linear interpolation (np.interp equivalent)
// --------------------------------------------------
double interp(double x, const double* xs, const double* ys, int n)
{
    int lo = 0;
    int hi = n - 1;

    // binary search
    while (hi - lo > 1) {
        int mid = (lo + hi) / 2;
        if (xs[mid] > x)
            hi = mid;
        else
            lo = mid;
    }

    double t = (x - xs[lo]) / (xs[hi] - xs[lo]);
    return ys[lo] + t * (ys[hi] - ys[lo]);
}

// --------------------------------------------------
// Clamp helper
// --------------------------------------------------
double clamp(double x, double lo, double hi)
{
    if (x < lo) return lo;
    if (x > hi) return hi;
    return x;
}

// --------------------------------------------------
// Inverse transform
// data:    input (n × d) [row-major]
// output:  output (n × d) [row-major]
// --------------------------------------------------
void inverse_transform(const float* data,
                       float* output,
                       int n, int d,
                       char* file_path)
{
    int n_file, d_file;
    double* grid;
    double* sorted_cols;

    load_transform_binary(file_path, &n_file, &d_file,
                          &grid, &sorted_cols);

    double lo = grid[0];
    double hi = grid[n_file - 1];

    for (int j = 0; j < d; j++) {
        const double* col = &sorted_cols[j * n_file];

        for (int i = 0; i < n; i++) {
            double z = data[i * d + j];

            // u = normal_cdf(z)
            double u = normal_cdf(z);

            // clamp
            u = clamp(u, lo, hi);

            // interpolate
            output[i * d + j] = (float)interp(u, grid, col, n_file);
        }
    }

    free(grid);
    free(sorted_cols);
}



  %}
/* Neutron parameters: (x,y,z,vx,vy,vz,t,sx,sy,sz,p) */
DECLARE
%{
  int local_id;
  int idx;
  int base;
  const OrtApi* api;
  int dim;
  double dt;
  double tot_vel;
  OrtValue* xt_tensor;
  OrtValue* t_tensor;
  OrtValue* output_tensor;
  float* xt;
  float* t_vals;
  float* output;
  double weight_norm;
  double n_training_samples;

  OrtSessionOptions* session_options;

  OrtEnv* env;
  OrtSession* session;

  OrtMemoryInfo* memory_info;
  OrtValue* input_tensors[1];

  const char* input_names[1];
  const char* output_names[1];

  float* output_data;
%}
INITIALIZE
%{
    local_id = 0;
    api = OrtGetApiBase()->GetApi(ORT_API_VERSION);


    // Create environment
    CHECK(api->CreateEnv(ORT_LOGGING_LEVEL_WARNING, "test", &env));

    // Create session options
    CHECK(api->CreateSessionOptions(&session_options));
    const char* keys[]   = {"ModelFormat"};
    const char* values[] = {"MLProgram"};

    CHECK(api->SessionOptionsAppendExecutionProvider(
        session_options,
        "CoreML",
        keys,
        values,
        1
    ));
    CHECK(api->SetSessionLogSeverityLevel(session_options, 0));
    // Optional: set number of threads. 0 means auto
    CHECK(api->SetIntraOpNumThreads(session_options, 0));
    CHECK(api->SetInterOpNumThreads(session_options, 0));

    // Set graph optimizations on
    CHECK(api->SetSessionGraphOptimizationLevel(
      session_options, ORT_ENABLE_ALL));

    // ========================================================================
    // =========================== LOAD MODEL =================================
    // ========================================================================
    CHECK(api->CreateSession(env, ML_filename, session_options, &session));
    if (verbose) printf("Model loaded successfully!\n");


    // Get number of training samples from metadata
    OrtModelMetadata* metadata;
    CHECK(api->SessionGetModelMetadata(session, &metadata));
    OrtAllocator *allocator;
    CHECK(api->GetAllocatorWithDefaultOptions(&allocator));
    char* value = NULL;
    CHECK(api->ModelMetadataLookupCustomMetadataMap(
        metadata,
        allocator,
        "n_training_samples",
        &value
    ));
    
    if (value) {
        n_training_samples = (double)atoi(value);
        printf("Number of neutron trained on: %s\n", value);
        allocator->Free(allocator, value);
    }
    if (verbose) printf("Loaded metadata successfully!\n");
    

    // ========================================================================
    // =========================== PREPARE SAMPLING ===========================
    // ========================================================================

    dim = 12;

    // Create memory info (CPU)
    CHECK(api->CreateCpuMemoryInfo(OrtArenaAllocator, OrtMemTypeDefault, &memory_info));

    // Input/output names (adjust if needed!)
    input_names[0] = "input";
    output_names[0] = "output";

    // Shapes
    int64_t xt_shape[] = {batch_size, dim};

    xt = (float*) malloc(batch_size * dim * sizeof(float));
    output   = (float*) malloc(batch_size * dim * sizeof(float));

    // Create Ort tensors

    CHECK(api->CreateTensorWithDataAsOrtValue(
        memory_info, xt, batch_size * dim * sizeof(float),
        xt_shape, 2, ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT, &xt_tensor));

    CHECK(api->CreateTensorWithDataAsOrtValue(
    memory_info, output, batch_size * dim * sizeof(float),
    xt_shape, 2, ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT, &output_tensor));

    input_tensors[0] = xt_tensor;
    if (verbose) printf("Arrays allocated successfully. INITIALIZE finished!\n");
    weight_norm = mcget_ncount()/n_training_samples;
    printf("Weight norm = %g\n", weight_norm);
%}
TRACE
%{
  if (local_id%batch_size == 0){
    double t0 = walltime();
    // ========================================================================
    // ======================== SAMPLING A BATCH OF NEUTRONS ==================
    // ========================================================================


    for (int i = 0; i < batch_size * dim; i++) {
        float u1 = ((float) rand()) / (float)RAND_MAX;
        float u2 = ((float) rand()) / (float)RAND_MAX;
        xt[i] = sqrtf(-2.0f * logf(u1)) * cosf(2.0f * M_PI * u2);
    }
    double t1 = walltime();
    printf("Gaussian init: %.3f ms\n", 1000.0 * (t1 - t0));
    t0 = walltime();
    CHECK(api->Run(
            session, NULL,
            input_names,
            (const OrtValue* const*)input_tensors, 1,
            output_names, 1,
            &output_tensor
    ));
    t1 = walltime();
    printf("ONNX Run: %.3f s\n", (t1 - t0));

    t0 = walltime();

    CHECK(api->GetTensorMutableData(output_tensor, (void**)&output_data));
    inverse_transform(output_data, output_data, batch_size, dim, transformer_filename);
    t1 = walltime();

    printf("inverse transform: %.3f ms\n",1000.0 * (t1 - t0));
  }
  
  idx = local_id % batch_size;
  base = idx * dim;


  p       = output_data[base + 0]*weight_norm;
  tot_vel = SE2V * sqrt(output_data[base + 1]*1e9);
  t       = output_data[base + 2] * 1e-3;
  vx      = output_data[base + 3] * tot_vel;
  vy      = output_data[base + 4] * tot_vel;
  vz      = output_data[base + 5] * tot_vel;
  x       = output_data[base + 6]/100;
  y       = output_data[base + 7]/100;
  z       = output_data[base + 8]/100;
  sx      = output_data[base + 9];
  sy      = output_data[base + 10];
  sz      = output_data[base + 11];

  local_id++;

%}


FINALLY 
%{
    // Cleanup tensors
    api->ReleaseValue(xt_tensor);
    api->ReleaseValue(output_tensor);

    // Cleanup
    free(xt);
    free(output);
    api->ReleaseMemoryInfo(memory_info);
    api->ReleaseSession(session);
    api->ReleaseSessionOptions(session_options);
    api->ReleaseEnv(env);
%}

MCDISPLAY
%{
%}

END
