*
* A source that samples from a machine learning model (Type Conditional Flow Matching)
*
* %D
* This component
*
* On CoreML (device=auto or device=coreml on Apple hardware), model load may
* print "E5RT encountered an STL exception ... unbounded dimension" to
* stderr. This is expected and harmless: the exported model's batch
* dimension is dynamic (so batch_size can differ from what the model was
* exported with), but CoreML's ML Program compiler cannot target the Neural
* Engine for a few ops (the inverse Gaussian-rank transform's Floor/
* GatherElements) under a dynamic batch shape. ONNX Runtime catches the
* failed compile attempt and automatically falls those specific ops back to
* CPU, so sampling still completes correctly -- the message is CoreML's own
* diagnostic output (bypassing ORT's logging, hence unaffected by verbose),
* not a fatal error. Restricting CoreML to a specific compute unit (or
* forcing static-only input shapes) silences the message but disables
* CoreML acceleration for the *entire* graph, not just those ops, so it is
* deliberately left as-is; only exporting the model with a fixed batch
* dimension matching this component's batch_size would eliminate it for
* real, at the cost of no longer being able to change batch_size without
* re-exporting.
*
* Example: Source_simple(radius=0.1, dist=2, focus_xw=.1, focus_yh=.1, E0=14, dE=2)
*
* %P
* gauss: [1]                          Gaussian (1) or Flat (0) energy/wavelength distribution
* device: [str]                       ONNX Runtime execution provider to use:
*                                      "auto" (default) picks the best available
*                                      GPU provider (CUDA, then ROCm, then CoreML)
*                                      and falls back to CPU; or force one of
*                                      "cuda"/"rocm"/"coreml"/"cpu" explicitly.
*
* %E
*******************************************************************************/

DEFINE COMPONENT Source_ML

SETTING PARAMETERS (string ML_filename="",
                    string device = "auto",
                    int batch_size = 10000,
                    verbose=1
                   )


DEPENDENCY "@MCPLFLAGS@ -I$CONDA_PREFIX/include -L$CONDA_PREFIX/lib -lonnxruntime -Wl,-rpath,$CONDA_PREFIX/lib"


SHARE
%{
  

  #include <stdio.h>
  #include "onnxruntime/core/session/onnxruntime_c_api.h"

  #include <stdlib.h>
  #include <string.h>
  #include <math.h>
  #include <sys/stat.h>
  #include <stdio.h>



  #define CHECK(status)                                  \
    if (status != NULL) {                              \
        fprintf(stderr, "Error: %s\n",                 \
                api->GetErrorMessage(status));         \
        api->ReleaseStatus(status);                   \
        exit(1);                                      \
    }

  #include <time.h>

double walltime()
{
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec + 1e-9 * ts.tv_nsec;
}

// --------------------------------------------------
// Hardware auto-detection: try to append a GPU-accelerated execution
// provider, preferring CUDA, then ROCm, then CoreML, falling back to CPU
// (ORT's own default) if none of those are compiled in or available on this
// machine. Each dedicated SessionOptionsAppendExecutionProvider_* call
// itself returns failure (not a crash) when that provider isn't usable, so
// these are safe to attempt speculatively even without checking
// GetAvailableProviders first -- but we check it anyway to avoid noisy
// failed-append log lines for providers that were never compiled in.
// --------------------------------------------------
int ep_provider_available(char** avail, int n_avail, const char* name)
{
    for (int i = 0; i < n_avail; i++) {
        if (strcmp(avail[i], name) == 0) return 1;
    }
    return 0;
}

OrtStatus* ep_append_cuda(const OrtApi* api, OrtSessionOptions* session_options)
{
    OrtCUDAProviderOptions cuda_options;
    memset(&cuda_options, 0, sizeof(cuda_options));
    cuda_options.device_id = 0;
    cuda_options.cudnn_conv_algo_search = OrtCudnnConvAlgoSearchExhaustive;
    cuda_options.gpu_mem_limit = (size_t)-1;
    cuda_options.do_copy_in_default_stream = 1;
    return api->SessionOptionsAppendExecutionProvider_CUDA(session_options, &cuda_options);
}

OrtStatus* ep_append_rocm(const OrtApi* api, OrtSessionOptions* session_options)
{
    OrtROCMProviderOptions rocm_options;
    memset(&rocm_options, 0, sizeof(rocm_options));
    rocm_options.device_id = 0;
    rocm_options.gpu_mem_limit = (size_t)-1;
    rocm_options.do_copy_in_default_stream = 1;
    return api->SessionOptionsAppendExecutionProvider_ROCM(session_options, &rocm_options);
}

OrtStatus* ep_append_coreml(const OrtApi* api, OrtSessionOptions* session_options)
{
    const char* keys[]   = {"ModelFormat"};
    const char* values[] = {"MLProgram"};
    return api->SessionOptionsAppendExecutionProvider(session_options, "CoreML", keys, values, 1);
}

// Attempts to append the named provider ("cuda"/"rocm"/"coreml"/"cpu").
// Returns 1 if the session will use it (for "cpu" this is trivially true --
// there is no EP to append, ORT always has a CPU fallback), 0 if the
// provider is unavailable or failed to append.
int ep_try_append(const OrtApi* api, OrtSessionOptions* session_options,
                   char** avail, int n_avail, const char* name, int verbose)
{
    OrtStatus* status = NULL;

    if (strcmp(name, "cpu") == 0) {
        if (verbose) printf("Source_ML: using cpu execution provider\n");
        return 1;
    } else if (strcmp(name, "cuda") == 0) {
        if (!ep_provider_available(avail, n_avail, "CUDAExecutionProvider")) return 0;
        status = ep_append_cuda(api, session_options);
    } else if (strcmp(name, "rocm") == 0) {
        if (!ep_provider_available(avail, n_avail, "ROCMExecutionProvider")) return 0;
        status = ep_append_rocm(api, session_options);
    } else if (strcmp(name, "coreml") == 0) {
        if (!ep_provider_available(avail, n_avail, "CoreMLExecutionProvider")) return 0;
        status = ep_append_coreml(api, session_options);
    } else {
        fprintf(stderr, "Source_ML: unknown device '%s'\n", name);
        return 0;
    }

    if (status != NULL) {
        if (verbose) {
            fprintf(stderr, "Source_ML: failed to append %s execution provider: %s\n",
                    name, api->GetErrorMessage(status));
        }
        api->ReleaseStatus(status);
        return 0;
    }
    if (verbose) printf("Source_ML: using %s execution provider\n", name);
    return 1;
}

  %}
/* Neutron parameters: (x,y,z,vx,vy,vz,t,sx,sy,sz,p) */
DECLARE
%{
  int local_id;
  int idx;
  int base;
  const OrtApi* api;
  int dim;
  double dt;
  double tot_vel;
  OrtValue* xt_tensor;
  OrtValue* t_tensor;
  OrtValue* output_tensor;
  float* xt;
  float* t_vals;
  float* output;
  double weight_norm;
  double n_training_samples;

  OrtSessionOptions* session_options;

  OrtEnv* env;
  OrtSession* session;

  OrtMemoryInfo* memory_info;
  OrtValue* input_tensors[1];

  const char* input_names[1];
  const char* output_names[1];

  float* output_data;
%}
INITIALIZE
%{
    local_id = 0;
    api = OrtGetApiBase()->GetApi(ORT_API_VERSION);


    // Create environment
    CHECK(api->CreateEnv(ORT_LOGGING_LEVEL_WARNING, "test", &env));

    // Create session options
    CHECK(api->CreateSessionOptions(&session_options));

    // ========================================================================
    // ===================== HARDWARE AUTO-DETECTION ==========================
    // ========================================================================
    char** avail_providers = NULL;
    int n_avail_providers = 0;
    CHECK(api->GetAvailableProviders(&avail_providers, &n_avail_providers));
    if (verbose) {
        printf("Source_ML: available execution providers:");
        for (int i = 0; i < n_avail_providers; i++) printf(" %s", avail_providers[i]);
        printf("\n");
    }

    if (strcmp(device, "auto") == 0) {
        static const char* device_priority[] = {"cuda", "rocm", "coreml", "cpu"};
        int n_device_priority = sizeof(device_priority) / sizeof(device_priority[0]);
        for (int i = 0; i < n_device_priority; i++) {
            if (ep_try_append(api, session_options, avail_providers, n_avail_providers,
                               device_priority[i], verbose)) {
                break;
            }
        }
    } else if (!ep_try_append(api, session_options, avail_providers, n_avail_providers,
                               device, verbose)) {
        fprintf(stderr, "Source_ML: requested device '%s' unavailable; falling back to CPU\n", device);
    }
    CHECK(api->ReleaseAvailableProviders(avail_providers, n_avail_providers));

    if (verbose){
      CHECK(api->SetSessionLogSeverityLevel(session_options, 0));
    }
    // Optional: set number of threads. 0 means auto
    CHECK(api->SetIntraOpNumThreads(session_options, 0));
    CHECK(api->SetInterOpNumThreads(session_options, 0));

    // Set graph optimizations on
    CHECK(api->SetSessionGraphOptimizationLevel(
      session_options, ORT_ENABLE_ALL));

    // ========================================================================
    // =========================== LOAD MODEL =================================
    // ========================================================================
    CHECK(api->CreateSession(env, ML_filename, session_options, &session));
    if (verbose) printf("Model loaded successfully!\n");


    // Get number of training samples from metadata
    OrtModelMetadata* metadata;
    CHECK(api->SessionGetModelMetadata(session, &metadata));
    OrtAllocator *allocator;
    CHECK(api->GetAllocatorWithDefaultOptions(&allocator));
    char* value = NULL;
    CHECK(api->ModelMetadataLookupCustomMetadataMap(
        metadata,
        allocator,
        "n_training_samples",
        &value
    ));
    
    if (value) {
        n_training_samples = (double)atoi(value);
        printf("Number of neutron trained on: %s\n", value);
        allocator->Free(allocator, value);
    }
    if (verbose) printf("Loaded metadata successfully!\n");
    

    // ========================================================================
    // =========================== PREPARE SAMPLING ===========================
    // ========================================================================

    dim = 12;

    // Create memory info (CPU)
    CHECK(api->CreateCpuMemoryInfo(OrtArenaAllocator, OrtMemTypeDefault, &memory_info));

    // Input/output names (adjust if needed!)
    input_names[0] = "input";
    output_names[0] = "output";

    // Shapes
    int64_t xt_shape[] = {batch_size, dim};

    xt = (float*) malloc(batch_size * dim * sizeof(float));
    output   = (float*) malloc(batch_size * dim * sizeof(float));

    // Create Ort tensors

    CHECK(api->CreateTensorWithDataAsOrtValue(
        memory_info, xt, batch_size * dim * sizeof(float),
        xt_shape, 2, ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT, &xt_tensor));

    CHECK(api->CreateTensorWithDataAsOrtValue(
    memory_info, output, batch_size * dim * sizeof(float),
    xt_shape, 2, ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT, &output_tensor));

    input_tensors[0] = xt_tensor;
    if (verbose) printf("Arrays allocated successfully. INITIALIZE finished!\n");
    weight_norm = mcget_ncount()/n_training_samples;
    printf("Weight norm = %g\n", weight_norm);
%}
TRACE
%{
  if (local_id%batch_size == 0){
    double t0 = walltime();
    // ========================================================================
    // ======================== SAMPLING A BATCH OF NEUTRONS ==================
    // ========================================================================


    for (int i = 0; i < batch_size * dim; i++) {
        xt[i] = randnorm();
    }
    double t1 = walltime();
    printf("Gaussian init: %.3f ms\n", 1000.0 * (t1 - t0));
    t0 = walltime();
    CHECK(api->Run(
            session, NULL,
            input_names,
            (const OrtValue* const*)input_tensors, 1,
            output_names, 1,
            &output_tensor
    ));
    t1 = walltime();
    printf("ONNX Run: %.3f s\n", (t1 - t0));

    CHECK(api->GetTensorMutableData(output_tensor, (void**)&output_data));
  }
  
  idx = local_id % batch_size;
  base = idx * dim;


  p       = output_data[base + 0]*weight_norm;
  tot_vel = SE2V * sqrt(output_data[base + 1]*1e9);
  t       = output_data[base + 2] * 1e-3;
  vx      = output_data[base + 3] * tot_vel;
  vy      = output_data[base + 4] * tot_vel;
  vz      = output_data[base + 5] * tot_vel;
  x       = output_data[base + 6]/100;
  y       = output_data[base + 7]/100;
  z       = output_data[base + 8]/100;
  sx      = output_data[base + 9];
  sy      = output_data[base + 10];
  sz      = output_data[base + 11];

  local_id++;

%}


FINALLY 
%{
    // Cleanup tensors
    api->ReleaseValue(xt_tensor);
    api->ReleaseValue(output_tensor);

    // Cleanup
    free(xt);
    free(output);
    api->ReleaseMemoryInfo(memory_info);
    api->ReleaseSession(session);
    api->ReleaseSessionOptions(session_options);
    api->ReleaseEnv(env);
%}

MCDISPLAY
%{
%}

END
